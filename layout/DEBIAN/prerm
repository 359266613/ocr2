#!/bin/sh
set -eu
case "${1:-}" in
    remove|deconfigure)
        PACKAGE="${DPKG_MAINTSCRIPT_PACKAGE:-com.axs.screenocr}"
        FILES="$(dpkg-query -L "$PACKAGE")"
        INFO="$(printf '%s\n' "$FILES" | while IFS= read -r FILE; do
            case "$FILE" in
                */Applications/AxsScreenOcrWorker.app/Info.plist)
                    printf '%s\n' "$FILE"
                    ;;
            esac
        done)"
        if [ -n "$INFO" ]; then
            APP="${INFO%/Info.plist}"
            PREFIX="${APP%/Applications/AxsScreenOcrWorker.app}"
            UICACHE="$PREFIX/usr/bin/uicache"
            if [ ! -x "$UICACHE" ]; then UICACHE="$(command -v uicache || true)"; fi
            if [ -n "$UICACHE" ] && [ -x "$UICACHE" ]; then "$UICACHE" -u "$APP" || true; fi
        fi
        ;;
esac
exit 0
